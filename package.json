{
  "name": "marci-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "test": "node --test server/test/*.test.js web/test/*.test.ts"
  }
}
